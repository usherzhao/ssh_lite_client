{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Client",
  "version": "1.0.0",
  "identifier": "com.sshclient.app",
  "build": {
    "beforeDevCommand": "npm run renderer:dev",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "title": "SSH Client",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["../assets/icon.ico"]
  },
  "plugins": {}
}
