{
  "name": "electron-ssh-client",
  "version": "1.0.0",
  "description": "Electron SSH Client with multi-tab and multi-window support",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.sshclient.app",
    "icon": "assets/icon.ico",
    "productName": "SSH Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
      { 
        "target": "nsis", 
        "arch": ["x64"] 
      },
      { 
        "target": "portable",  
        "arch": ["x64"] 
      }
    ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/**/*",
      "node_modules/ssh2/**/*",
      "node_modules/cpu-features/**/*",
      "node_modules/sshcrypto/**/*",
      "node_modules/mysql2/**/*"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "mysql2": "^3.22.0",
    "sql.js": "^1.10.3",
    "ssh2": "^1.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^26.8.1"
  },
  "author": "",
  "license": "MIT"
}
